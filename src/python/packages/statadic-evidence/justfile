set shell := ["bash", "-euo", "pipefail", "-c"]
app := source_directory()
runner := "env -u PYTHONPATH -u PYTHONHOME -u VIRTUAL_ENV uv run --project '" + app + "/../..' --offline --frozen --package statadic-evidence --group dev"

check:
    {{ runner }} python -m ruff check '{{ app }}/src' '{{ app }}/tests'
    {{ runner }} python -m ruff format --check '{{ app }}/src' '{{ app }}/tests'
    {{ runner }} python -m pytest -q '{{ app }}/tests'

fmt:
    {{ runner }} python -m ruff format '{{ app }}/src' '{{ app }}/tests'
